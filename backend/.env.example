# ----- Conexión a PostgreSQL -----
DB_NOMBRE=papelyluna
DB_USUARIO=papelyluna
DB_CLAVE=papelyluna
DB_SERVIDOR=localhost
DB_PUERTO=5432

# ----- Django -----
# Al desplegar: poner una clave secreta propia y DJANGO_DEBUG=False
DJANGO_SECRET_KEY=clave-solo-para-desarrollo-papel-y-luna
DJANGO_DEBUG=True

# Orígenes que pueden llamar a la API, separados por coma. Vacío = cualquiera (solo desarrollo).
# Ejemplo al desplegar: CORS_ORIGENES=https://usuario.github.io
CORS_ORIGENES=

# Render configura estos valores automáticamente mediante render.yaml.
# SECRET_KEY=una-clave-larga-y-aleatoria
# DEBUG=False
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/base
# ALLOWED_HOSTS=tu-api.onrender.com,api.tudominio.com
# DATABASE_SSL_REQUIRE=True
# CSRF_TRUSTED_ORIGINS=https://tu-frontend.example.com

# Opcional: claves para usuarios NUEVOS. No modifica usuarios existentes.
# INITIAL_ADMIN_PASSWORD=elige-una-clave-propia
# INITIAL_CASHIER_PASSWORD=elige-otra-clave-propia
